APP_ENV=development
INTERNET_EXPOSED=false
AUTH_REQUIRED=false
AUTH_MODE=session

DATABASE_URL=postgresql://gardenops:change-me@127.0.0.1:5432/gardenops

APP_NAME=GardenOps
APP_SLUG=gardenops
VITE_APP_NAME=GardenOps
VITE_APP_SLUG=gardenops
VITE_SHADEMAP_ENABLED=true

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],::1,testserver
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUST_PROXY_HEADERS=false

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=gardenops:ratelimit

AUTH_API_KEY=change-me
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLE=admin
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_ABSOLUTE_TTL_HOURS=168
AUTH_MFA_SECRET_KEY=
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_ORIGINS=http://localhost:5173
AUTH_PASSKEY_CHALLENGE_TTL_SECONDS=300
APP_SECRETS_ENCRYPTION_KEY=

AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
AI_CHAT_PROVIDER_TIMEOUT_SECONDS=60
AI_CHAT_MAX_OUTPUT_TOKENS=1024
PLANTNET_API_KEY=

# Private MCP server and optional single-room Matrix assistant.
MCP_ENABLED=false
MCP_BEARER_TOKEN=
MCP_URL=http://127.0.0.1:8000/mcp
MATRIX_ENABLED=false
MATRIX_HOMESERVER_URL=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=
MATRIX_STORE_PATH=/opt/gardenops/matrix
MATRIX_E2EE=true
MATRIX_ROOM_ID=
MATRIX_ALLOWED_SENDER=
MATRIX_GARDENOPS_USERNAME=
MATRIX_GARDEN_SLUG=
MATRIX_TRIGGER_MODE=mention
MATRIX_TIMEZONE=Europe/Oslo
MATRIX_CAPTURE_TTL_DAYS=7
MATRIX_SYNC_TIMEOUT_MS=30000
MATRIX_MAX_PENDING_EVENTS=20
MATRIX_CAPTURE_RATE_LIMIT=12
LOG_LEVEL=INFO

# Optional paid third-party ShadeMap integration.
# Obtain your own access from https://shademap.app/about before enabling.
SHADEMAP_ENABLED=true
SHADEMAP=
SHADEMAP_PUBLIC_API_KEY=
SHADEMAP_TILE_SIGNING_SECRET=
# Optional licensed, self-contained ShadeMap runtime JavaScript. GardenOps proxies it to authenticated browsers.
SHADEMAP_RUNTIME_SCRIPT_URL=
SHADEMAP_RUNTIME_SCRIPT_RATE_LIMIT=20
SHADEMAP_RUNTIME_SCRIPT_RATE_LIMIT_USER=20
SHADEMAP_RUNTIME_SCRIPT_RATE_LIMIT_GARDEN=40
SHADEMAP_RUNTIME_SCRIPT_RATE_LIMIT_GLOBAL=200
SHADEMAP_RUNTIME_SCRIPT_CONCURRENCY_LIMIT=2
SHADEMAP_SHARE_URL=
SHADEMAP_LAT=51.50095
SHADEMAP_LNG=-0.12448
SHADEMAP_ZOOM=17
SHADEMAP_LABEL=Garden
SHADEMAP_LOCAL_TERRAIN_PATH=
# Required when using the shared local terrain path; prevents another garden from reading it.
SHADEMAP_LOCAL_TERRAIN_GARDEN_ID=
