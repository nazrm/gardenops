[Unit]
Description=Deploy tested merged GardenOps dependency updates
Wants=network-online.target
After=network-online.target
OnFailure=gardenops-security-deploy-failed.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=gardenops-security-deploy
Environment=GARDENOPS_CONTROL_REPO=/var/lib/gardenops-security-deploy/repository.git
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/gardenops-security-deploy.py --config /etc/gardenops-security-deploy.json --apply
TimeoutStartSec=40min
TimeoutStopSec=30s
KillMode=control-group
Nice=10
StandardOutput=journal
StandardError=journal
